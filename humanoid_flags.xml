<mujoco model="flag_game_humanoid">
  <!--
    청기백기 휴머노이드 (MuJoCo 4)
      - 오른손: 청기(파랑) / 왼손: 백기(흰색)
      - 깃대는 팔 연장선(스피어 방식): 팔을 올리면 깃대가 수직으로 하늘로!
      - 깃발 천은 수동 힌지로 팔을 빠르게 움직이면 살랑살랑 펄럭임
      - 전 관절 위치 서보(position actuator)로 사람처럼 빠릿하게 동작
  -->
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.001" solver="Newton" iterations="100" tolerance="1e-10"/>

  <visual>
    <headlight ambient="0.35 0.35 0.4" diffuse="0.7 0.7 0.7"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <statistic center="0 0 0.9" extent="1.7"/>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.30 0.34 0.44" rgb2="0.04 0.05 0.08" width="512" height="512"/>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.13 0.14 0.17" rgb2="0.17 0.19 0.23" width="400" height="400"/>
    <material name="floor_mat" texture="checker" texrepeat="8 8" reflectance="0.15"/>
    <material name="stage_mat" rgba="0.10 0.11 0.14 1" specular="0.25" shininess="0.5"/>
    <material name="body_mat"  rgba="0.85 0.87 0.92 1" specular="0.35" shininess="0.6"/>
    <material name="dark_mat"   rgba="0.14 0.15 0.19 1" specular="0.45" shininess="0.7"/>
    <material name="accent_mat" rgba="0.96 0.45 0.12 1" specular="0.3" shininess="0.5"/>
    <material name="eye_mat" rgba="0 0.95 1 1" emission="1"/>
    <material name="silver_mat" rgba="0.75 0.77 0.8 1" specular="0.6" shininess="0.8"/>
  </asset>

  <default>
    <joint damping="0.6" armature="0.01"/>
    <geom condim="3" friction="1.2 0.005 0.0001" density="1000"/>
    <default class="arm">
      <joint damping="5.0" armature="0.015"/>
    </default>
    <default class="leg">
      <joint damping="8.0" armature="0.02"/>
    </default>
    <default class="ankle">
      <joint damping="60.0" armature="0.03"/>
    </default>
    <default class="pole">
      <geom contype="0" conaffinity="0" material="silver_mat"/>
    </default>
    <default class="flagcloth">
      <joint damping="0.04" stiffness="0.3" springref="0"/>
      <geom contype="0" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 -1.2 3.2" dir="-0.1 0.35 -1" diffuse="0.9 0.9 0.92" specular="0.2 0.2 0.2"/>
    <light pos="2.2 -1.6 1.8" dir="-0.55 0.4 -0.75" diffuse="0.4 0.42 0.5" specular="0 0 0" castshadow="false"/>
    <light pos="-2.0 -1.0 2.2" dir="0.5 0.3 -0.85" diffuse="0.3 0.3 0.34" specular="0 0 0" castshadow="false"/>

    <geom name="floor" type="plane" size="8 8 0.1" material="floor_mat"/>
    <geom name="stage" type="cylinder" size="1.7 0.02" pos="0 0 0.021" material="stage_mat"/>

    <!-- 대략적인 정면 카메라 (뷰어에서 자유 카메라로 전환해도 됨) -->
    <camera name="frontcam" pos="2.9 -1.9 1.5" xyaxes="0.54 0.84 0 -0.12 -0.08 0.99" fovy="42"/>

    <!-- ==================== 골반 (자유 관절) ==================== -->
    <body name="pelvis" pos="0 0 0.93">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="box" size="0.10 0.075 0.06" mass="8" material="dark_mat"/>

      <!-- ==================== 몸통 ==================== -->
      <body name="torso" pos="0 0 0.10">
        <geom name="torso_geom" type="box" size="0.115 0.085 0.185" pos="0 0 0.13" mass="16" material="body_mat"/>
        <!-- 가슴 액센트 -->
        <geom name="chest_plate" type="box" size="0.02 0.055 0.07" pos="0.105 0 0.12" mass="0.3" material="accent_mat"/>
        <geom name="back_pack" type="box" size="0.03 0.06 0.08" pos="-0.125 0 0.14" mass="0.6" material="dark_mat"/>

        <!-- ==================== 머리 ==================== -->
        <body name="head" pos="0 0 0.42">
          <geom name="neck" type="cylinder" fromto="0 0 -0.03 0 0 0.06" size="0.035" mass="0.4" material="dark_mat"/>
          <geom name="head_geom" type="sphere" size="0.10" pos="0 0 0.15" mass="3.5" material="body_mat"/>
          <!-- 로봇 얼굴 -->
          <geom name="face_plate" type="box" size="0.03 0.075 0.055" pos="0.078 0 0.16" mass="0.1" material="dark_mat"/>
          <geom name="eye_r" type="sphere" size="0.014" pos="0.098 -0.028 0.175" mass="0.01" material="eye_mat"/>
          <geom name="eye_l" type="sphere" size="0.014" pos="0.098 0.028 0.175" mass="0.01" material="eye_mat"/>
          <geom name="mouth" type="box" size="0.008 0.03 0.007" pos="0.098 0 0.125" mass="0.01" material="eye_mat"/>
          <!-- 안테나 -->
          <geom name="antenna" type="capsule" fromto="0 0 0.24 0 0 0.33" size="0.006" mass="0.05" material="dark_mat"/>
          <geom name="antenna_tip" type="sphere" size="0.013" pos="0 0 0.335" mass="0.02" material="accent_mat"/>
        </body>

        <!-- ==================== 오른팔 (청기) ==================== -->
        <body name="r_upper_arm" pos="0 -0.215 0.27" childclass="arm">
          <joint name="r_shoulder_pitch" type="hinge" axis="0 -1 0" range="-0.35 3.05"/>
          <joint name="r_shoulder_roll"  type="hinge" axis="-1 0 0" range="-0.15 1.60"/>
          <geom name="r_deltoid" type="sphere" size="0.062" mass="0.35" material="body_mat"/>
          <geom name="r_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.28" size="0.048" mass="1.3" material="body_mat"/>

          <body name="r_forearm" pos="0 0 -0.28">
            <joint name="r_elbow" type="hinge" axis="0 -1 0" range="0 2.6"/>
            <geom name="r_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.25" size="0.042" mass="0.9" material="body_mat"/>

            <body name="r_hand" pos="0 0 -0.25">
              <geom name="r_hand_geom" type="sphere" size="0.055" mass="0.4" material="dark_mat"/>
              <!-- 손목 밴드: 오른쪽 = 파랑 -->
              <geom name="r_wrist_band" type="cylinder" fromto="0 0 0.015 0 0 -0.045" size="0.058" mass="0.05" rgba="0.1 0.32 0.95 1"/>

              <!-- 깃대 (팔 연장선) -->
              <body name="r_flagpole" childclass="pole">
                <geom name="r_pole" type="cylinder" fromto="0 0 -0.02 0 0 -0.52" size="0.011" mass="0.22"/>
                <geom name="r_pole_grip" type="cylinder" fromto="0 0 -0.02 0 0 -0.085" size="0.015" mass="0.04" rgba="0.1 0.32 0.95 1"/>
                <geom name="r_pole_cap" type="sphere" size="0.017" pos="0 0 -0.52" mass="0.02" material="accent_mat"/>

                <!-- 청기 (파란 깃발) - 힌지로 펄럭임 -->
                <body name="r_flag" pos="0 0 -0.50" childclass="flagcloth">
                  <joint name="r_flag_hinge" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
                  <geom name="r_flag_cloth" type="box" size="0.14 0.085 0.004" pos="0.155 0 -0.025" mass="0.12" rgba="0.08 0.28 0.92 1"/>
                  <geom name="r_flag_stripe" type="box" size="0.14 0.02 0.005" pos="0.155 0 0.052" mass="0.02" rgba="0.92 0.94 1 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>

        <!-- ==================== 왼팔 (백기) ==================== -->
        <body name="l_upper_arm" pos="0 0.215 0.27" childclass="arm">
          <joint name="l_shoulder_pitch" type="hinge" axis="0 -1 0" range="-0.35 3.05"/>
          <joint name="l_shoulder_roll"  type="hinge" axis="1 0 0" range="-0.15 1.60"/>
          <geom name="l_deltoid" type="sphere" size="0.062" mass="0.35" material="body_mat"/>
          <geom name="l_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.28" size="0.048" mass="1.3" material="body_mat"/>

          <body name="l_forearm" pos="0 0 -0.28">
            <joint name="l_elbow" type="hinge" axis="0 -1 0" range="0 2.6"/>
            <geom name="l_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.25" size="0.042" mass="0.9" material="body_mat"/>

            <body name="l_hand" pos="0 0 -0.25">
              <geom name="l_hand_geom" type="sphere" size="0.055" mass="0.4" material="dark_mat"/>
              <!-- 손목 밴드: 왼쪽 = 흰색 -->
              <geom name="l_wrist_band" type="cylinder" fromto="0 0 0.015 0 0 -0.045" size="0.058" mass="0.05" rgba="0.92 0.93 0.96 1"/>

              <body name="l_flagpole" childclass="pole">
                <geom name="l_pole" type="cylinder" fromto="0 0 -0.02 0 0 -0.52" size="0.011" mass="0.22"/>
                <geom name="l_pole_grip" type="cylinder" fromto="0 0 -0.02 0 0 -0.085" size="0.015" mass="0.04" rgba="0.92 0.93 0.96 1"/>
                <geom name="l_pole_cap" type="sphere" size="0.017" pos="0 0 -0.52" mass="0.02" material="accent_mat"/>

                <!-- 백기 (흰 깃발) -->
                <body name="l_flag" pos="0 0 -0.50" childclass="flagcloth">
                  <joint name="l_flag_hinge" type="hinge" axis="0 1 0" range="-1.3 1.3"/>
                  <geom name="l_flag_cloth" type="box" size="0.14 0.085 0.004" pos="0.155 0 -0.025" mass="0.12" rgba="0.93 0.94 0.98 1"/>
                  <geom name="l_flag_stripe" type="box" size="0.14 0.02 0.005" pos="0.155 0 0.052" mass="0.02" rgba="0.25 0.45 0.95 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== 오른다리 ==================== -->
      <body name="r_hip" pos="0 -0.095 -0.06" childclass="leg">
        <joint name="r_hip_pitch" type="hinge" axis="0 -1 0" range="-0.6 1.6"/>
        <joint name="r_hip_roll"  type="hinge" axis="-1 0 0" range="-0.35 0.6"/>
        <geom name="r_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.38" size="0.062" mass="5.2" material="body_mat"/>

        <body name="r_shin" pos="0 0 -0.38">
          <joint name="r_knee" type="hinge" axis="0 1 0" range="-0.05 1.9"/>
          <geom name="r_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.35" size="0.052" mass="3.3" material="body_mat"/>

          <body name="r_foot" pos="0 0 -0.35" childclass="ankle">
            <joint name="r_ankle_pitch" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
            <joint name="r_ankle_roll"  type="hinge" axis="-1 0 0" range="-0.4 0.4"/>
            <geom name="r_foot_geom" type="box" size="0.18 0.068 0.05" pos="0.02 0 -0.05" mass="1.0" material="dark_mat" friction="2.0 0.008 0.0002"/>
          </body>
        </body>
      </body>

      <!-- ==================== 왼다리 ==================== -->
      <body name="l_hip" pos="0 0.095 -0.06" childclass="leg">
        <joint name="l_hip_pitch" type="hinge" axis="0 -1 0" range="-0.6 1.6"/>
        <joint name="l_hip_roll"  type="hinge" axis="1 0 0" range="-0.35 0.6"/>
        <geom name="l_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.38" size="0.062" mass="5.2" material="body_mat"/>

        <body name="l_shin" pos="0 0 -0.38">
          <joint name="l_knee" type="hinge" axis="0 1 0" range="-0.05 1.9"/>
          <geom name="l_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.35" size="0.052" mass="3.3" material="body_mat"/>

          <body name="l_foot" pos="0 0 -0.35" childclass="ankle">
            <joint name="l_ankle_pitch" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
            <joint name="l_ankle_roll"  type="hinge" axis="1 0 0" range="-0.4 0.4"/>
            <geom name="l_foot_geom" type="box" size="0.18 0.068 0.05" pos="0.02 0 -0.05" mass="1.0" material="dark_mat" friction="2.0 0.008 0.0002"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ==================== 액추에이터 (위치 서보) ==================== -->
  <actuator>
    <!-- 팔: 빠릿! -->
    <position name="act_r_shoulder_pitch" joint="r_shoulder_pitch" kp="220" ctrlrange="-0.35 3.05" forcerange="-70 70"/>
    <position name="act_r_shoulder_roll"  joint="r_shoulder_roll"  kp="120" ctrlrange="-0.15 1.60" forcerange="-50 50"/>
    <position name="act_r_elbow"          joint="r_elbow"          kp="130" ctrlrange="0 2.6"     forcerange="-50 50"/>
    <position name="act_l_shoulder_pitch" joint="l_shoulder_pitch" kp="220" ctrlrange="-0.35 3.05" forcerange="-70 70"/>
    <position name="act_l_shoulder_roll"  joint="l_shoulder_roll"  kp="120" ctrlrange="-0.15 1.60" forcerange="-50 50"/>
    <position name="act_l_elbow"          joint="l_elbow"          kp="130" ctrlrange="0 2.6"     forcerange="-50 50"/>

    <!-- 다리: 균형 유지 -->
    <position name="act_r_hip_pitch" joint="r_hip_pitch" kp="400" ctrlrange="-0.6 1.6" forcerange="-180 180"/>
    <position name="act_r_hip_roll"  joint="r_hip_roll"  kp="250" ctrlrange="-0.35 0.6" forcerange="-120 120"/>
    <position name="act_r_knee"      joint="r_knee"      kp="550" ctrlrange="-0.05 1.9" forcerange="-220 220"/>
    <position name="act_r_ankle_pitch" joint="r_ankle_pitch" kp="1500" ctrlrange="-0.7 0.7" forcerange="-500 500"/>
    <position name="act_r_ankle_roll"  joint="r_ankle_roll"  kp="800" ctrlrange="-0.4 0.4" forcerange="-300 300"/>
    <position name="act_l_hip_pitch" joint="l_hip_pitch" kp="400" ctrlrange="-0.6 1.6" forcerange="-180 180"/>
    <position name="act_l_hip_roll"  joint="l_hip_roll"  kp="250" ctrlrange="-0.35 0.6" forcerange="-120 120"/>
    <position name="act_l_knee"      joint="l_knee"      kp="550" ctrlrange="-0.05 1.9" forcerange="-220 220"/>
    <position name="act_l_ankle_pitch" joint="l_ankle_pitch" kp="1500" ctrlrange="-0.7 0.7" forcerange="-500 500"/>
    <position name="act_l_ankle_roll"  joint="l_ankle_roll"  kp="800" ctrlrange="-0.4 0.4" forcerange="-300 300"/>
  </actuator>
</mujoco>
